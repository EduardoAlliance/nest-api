# APP
PORT=3000
NODE_ENV=development
API_VERSION=v1

# DATABASE
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=nest_api

# JWT
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
REFRESH_SECRET=super-secret-refresh-key-change-in-production
REFRESH_EXPIRES_IN=7d

# PKCE
PKCE_CODE_CHALLENGE_METHOD=S256

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# EMAIL (Mailpit)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@example.com

# RATE LIMIT
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:5173
